# Copia este archivo a .env.local para desarrollo, y configura las mismas
# variables en Vercel (Project Settings → Environment Variables) para producción.

# Supabase (Project Settings → API en el dashboard de Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave para firmar las cookies de sesión. Cualquier string largo y
# aleatorio sirve, pero no la cambies una vez en producción: invalidaría
# la sesión de todos los atletas conectados.
SESSION_SECRET=

# Contraseña para entrar a /admin (la página desde la que se crean las
# cuentas de los atletas y se generan sus links de activación). Elige
# cualquier contraseña — no hace falta avisarle a nadie más cuál es.
ADMIN_PASSWORD=
