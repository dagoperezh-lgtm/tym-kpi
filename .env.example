# Copia este archivo a .env.local para desarrollo, y configura las mismas
# variables en Vercel (Project Settings → Environment Variables) para producción.

# Supabase (Project Settings → API en el dashboard de Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave para firmar las cookies de sesión. Cualquier string largo y
# aleatorio sirve, pero no la cambies una vez en producción: invalidaría
# la sesión de todos los atletas conectados.
SESSION_SECRET=

# Contraseña para la página /sincronizar (la que trae los datos de la
# semana desde el Maestro). Elige cualquier contraseña.
SYNC_PASSWORD=

# Cuenta de servicio de Google con permiso de LECTURA sobre el Maestro en
# Drive — puede ser la misma que ya usa club-kpi-platform. Pega el JSON
# completo de la credencial como un solo string.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID del archivo Maestro en Drive (el mismo que usa club-kpi-platform).
DRIVE_MAESTRO_FILE_ID=
